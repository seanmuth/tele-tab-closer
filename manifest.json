{
  "description": "Close the Teleport tab once it's redirected",
  "homepage_url": "https://github.com/seanmuth/tele-tab-closer",
  "manifest_version": 3,
  "name": "Tele tab closer",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://tele.astronomer.cloud/",
    "https://tele.gcp0001.us-east4.astronomer.io/"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tele-tab-closer@seanmuth",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "128": "icon-128.png"
  },
  "version": "0.2.0"
}
